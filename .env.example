# Copy this file to .env and fill in the values.
# .env is in .gitignore — never commit real credentials.

# ── Anthropic ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Firebase Admin credentials ───────────────────────────────────
# Option A: path to a downloaded service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json

# Option B: individual fields from the service account JSON
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private_key value exactly as it appears in the JSON,
# replacing actual newlines with the two-character sequence \n
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvA...\n-----END PRIVATE KEY-----\n
